{
	"geode": "4.2.0",
	"gd": {
		"win": "2.2074",
		"android": "2.2074",
		"mac": "2.2074"
	},
	"version": "v4.0.0",
	"id": "spaghettdev.gd-roulette",
	"name": "GD-Roulette",
	"developer": "SpaghettDev",
	"description": "An in-game level roulette.",
	"links": {
		"community": "https://discord.gg/3bShQb6Jz3",
		"source": "https://github.com/SpaghettDev/GD-Roulette"
	},
	"issues": {
		"info": "Report any bugs/suggestions here.",
		"url": "https://github.com/SpaghettDev/GD-Roulette/issues"
	},
	"resources": {
		"sprites": [
			"resources/buttons/*.png",
			"resources/game/*.png",
			"resources/misc/*.png"
		],
		"spritesheets": {
			"ListBorder": ["resources/misc/ListBorder/*.png"]
		}
	},
	"dependencies": {
		"geode.node-ids": {
			"version": ">=v1.17.0",
			"importance": "required"
		},
		"alphalaneous.pages_api": {
			"version": ">=v1.4.1",
			"importance": "suggested"
		}
	},
	"tags": [
		"interface", "online", "content"
	],
	"settings": {
		"max-skips": {
			"name": "Number of skips",
			"description": "The maximum amount of skips allowed during a round of the roulette.",
			"type": "int",
			"control": {
				"input": true,
				"arrows": true,
				"arrow-step": 1,
				"big-arrows": true,
				"big-arrow-step": 5
			},
			"default": 3,
			"max": 9999,
			"min": 0
		},
		"hide-goal-reached": {
			"name": "Hide Goal Reached",
			"description": "Hide the 'Goal Reached!' popup after a short while after reaching the goal.",
			"type": "bool",
			"default": true
		},
		"use-big-button": {
			"name": "Use big button",
			"description": "Use a big button rather than the small circle button. Only works with Pages API installed.",
			"type": "bool",
			"default": false
		}
	}
}